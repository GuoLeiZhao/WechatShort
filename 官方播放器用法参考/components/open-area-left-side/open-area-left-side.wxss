.unlock {
  left: 0;
  top: 0;
  bottom: 0;
  right: 0;
  position: absolute;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 0 16rpx;
  gap: 16rpx;
}

.go-back-btn {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  color: white;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  box-sizing: border-box;
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  color: white;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
}

.back-unlock {
  box-sizing: border-box;
  flex: 2;
  background: rgba(255, 255, 255, 1);
  border: 1px solid rgba(255, 255, 255, 1);
  border-radius: 20rpx;
  color: black;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
}
